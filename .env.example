# Copy to .env.local for local development (never commit real keys).
# `npm run dev` uses the free mock writer unless AI_GATEWAY_API_KEY is set here.

# Your own AI Gateway key, for live writing on your machine only. Production needs no
# key: the deployment authenticates to AI Gateway with its OIDC token.
# AI_GATEWAY_API_KEY=

# Optional settings (the defaults are shown). All of them also work in Vercel.
# DH_TRIAL_MODEL=anthropic/claude-haiku-5.5   # who writes the free pages
# DH_TRIAL_PAGES=10                           # free pages per device, per window
# DH_TRIAL_EXTRAS=50                          # free quick tools (peeks, sketches...) per device
# DH_TRIAL_NETWORK_PAGES=100                  # free pages per network (IP): schools, offices and carriers share one
# DH_TRIAL_NETWORK_EXTRAS=500                 # free quick tools per network
# DH_TRIAL_WINDOW_DAYS=30                     # allowances renew after this
# DH_TRIAL_OFF=0                              # 1 pauses the trial (keys still work)
# DH_SALT=                                    # secret salt for hashing networks; set in production

# Exact trial counting (recommended before sharing widely): add Upstash Redis from the
# Vercel Marketplace and connect it to the project, which sets these. Without them the
# counts live in Vercel Runtime Cache, which can drift when several instances run.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# DH_MOCK=1                                   # force the mock writer (ignored in production)
