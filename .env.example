# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server only — never expose)
SUPABASE_SECRET_KEY=

# GitHub server PAT: fine-grained, "Public repositories (read-only)", zero account permissions.
# Used for ALL GitHub reads (repo lists, metadata, READMEs). We deliberately do not use
# per-user provider tokens — see plan Part 2 §GitHub.
GITHUB_TOKEN=

# Shared secret guarding /api/cron/* endpoints
CRON_SECRET=

# AI enrichment/moderation provider. GEMINI_API_KEY (Google AI Studio, free
# tier) takes precedence over AI_GATEWAY_API_KEY (Vercel AI Gateway, paid
# credits). AI_GATEWAY_MODEL overrides the default model id for either.
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# AI spend guardrails (docs/architecture.md "Scale"). Defaults: 800/day
# (≈≤$0.48), 5000 lifetime (≈≤$3), 30s per call. 0 = kill-switch (budget
# ceilings only; the timeout treats 0 as unset).
AI_DAILY_MAX=
AI_TOTAL_MAX=
AI_CALL_TIMEOUT_MS=

# Retro-moderation review threshold (stars at/under which published imports
# join the AI screening queue). Default 20.
AUTO_APPROVE_MIN_STARS=

# Error monitoring (P4). Publishable DSN; absent = Sentry fully inert, and
# CSP's connect-src/report-uri entries for Sentry are omitted.
NEXT_PUBLIC_SENTRY_DSN=

# CSP rollout switch (P4): unset = Content-Security-Policy-Report-Only;
# 1 = enforcing. Flip in Vercel env after a clean burn-in.
CSP_ENFORCE=
