{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/write.js": {
      "maxDuration": 120,
      "supportsCancellation": true,
      "includeFiles": "lib/seeds/**"
    },
    "api/picture.js": {
      "maxDuration": 10
    },
    "api/share.js": {
      "maxDuration": 5,
      "includeFiles": "{lib/seeds/index.json,src/static/share/index.json}"
    }
  },
  "rewrites": [
    {
      "source": "/:topic((?!api$|fonts$)[^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "Slackbot|Twitterbot|facebookexternalhit|Facebot|Discordbot|LinkedInBot|TelegramBot|^WhatsApp/"
          }
        }
      ],
      "destination": "/api/share?topic=:topic"
    },
    {
      "source": "/connect/:a/:b",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "Slackbot|Twitterbot|facebookexternalhit|Facebot|Discordbot|LinkedInBot|TelegramBot|^WhatsApp/"
          }
        }
      ],
      "destination": "/api/share?a=:a&b=:b"
    },
    {
      "source": "/trail/:steps*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "Slackbot|Twitterbot|facebookexternalhit|Facebot|Discordbot|LinkedInBot|TelegramBot|^WhatsApp/"
          }
        }
      ],
      "destination": "/api/share?trail=:steps*"
    },
    {
      "source": "/connect/:a/:b",
      "destination": "/"
    },
    {
      "source": "/trail/:steps*",
      "destination": "/"
    },
    {
      "source": "/((?!api$|fonts$)[^/.]+)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/share/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!api$|fonts$)[^/.]+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/connect/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/trail/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
